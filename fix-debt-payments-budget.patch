+  /**
+   * Debt payments that belong to one budget month. A debt counts when it still
+   * has a balance, or when a payment was recorded against it for that month.
+   * The second rule matters: marking the final payment as paid drops the
+   * balance to zero, and without it the debt would disappear from the budget
+   * of the very month it was paid in, so Left to spend would jump back up.
+   * @param {Array} debts
+   * @param {Array} debtPayments - payment ledger records ({ debtId, month })
+   * @param {string} monthKey - 'YYYY-MM' budget month
+   */
+  function calculateMonthDebtPayments(debts, debtPayments, monthKey, exchangeRates, baseCurrency) {
+    const paidThisMonth = new Set((debtPayments || []).filter((payment) => payment.month === monthKey).map((payment) => payment.debtId));
+    return debts.reduce((total, debt) => {
+      const cleared = debt.currentBalance !== undefined && Number(debt.currentBalance) <= 0.01;
+      if (cleared && !paidThisMonth.has(debt.id)) return total;
+      return total + debtValueInCurrency(debt, monthlyMinPayment(debt), exchangeRates, baseCurrency);
+    }, 0);
+  }
